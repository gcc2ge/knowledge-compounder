# 私有内容:你的知识库不进开源仓库
# raw 与 wiki 是用户私有知识资产,默认不提交。需要时手动 git add -f
raw/*
!raw/.gitkeep
wiki/*
!wiki/.gitkeep
wiki/health/*
!wiki/health/.gitkeep

# 编译产物
/kcp

# 向量缓存(派生数据,可随时重建)
.kcp-embed-cache.json

# 评估运行报告(派生;评估种子 eval/seeds/ 保留)
eval/reports/

# 本地环境
.DS_Store
*.swp
__pycache__/
*.pyc

# 观察与临时文件
raw/observations/*

# 本地配置
.claude/settings.local.json
